# Template only. scripts/bootstrap-env.sh writes the real ignored .env.
# Never commit .env or put real secrets in this file.

APP_ENV=production
APP_PORT=8080
PUBLIC_ORIGIN=https://agent-office.example.invalid

POSTGRES_DB=agent_office
POSTGRES_USER=agent_office_admin
# Generated admin password. Only the database and one-shot migration service receive it.
POSTGRES_PASSWORD=replace-with-generated-admin-password
APP_DB_USER=agent_office_app
APP_DB_PASSWORD=replace-with-generated-app-password
DATABASE_URL=postgresql+asyncpg://agent_office_app:replace-with-generated-app-password@db:5432/agent_office
MIGRATION_DATABASE_URL=postgresql+asyncpg://agent_office_admin:replace-with-generated-admin-password@db:5432/agent_office
OWNER_USERNAME=owner
# Argon2id hash, never plaintext.
OWNER_PASSWORD_HASH=replace-with-argon2id-hash
# At least 32 random bytes, hex recommended. Rotating it invalidates sessions.
SESSION_SECRET=replace-with-at-least-32-random-bytes-hex
# Internal Runner-to-API bearer token.
RUNNER_SHARED_TOKEN=replace-with-64-hex-characters
# Internal Runner-to-Docker-launcher bearer token; separate from the API token.
RUNTIME_LAUNCHER_TOKEN=replace-with-64-hex-characters
# Test-only administrator URL. Keep the database name suffixed with `_test`.
TEST_DATABASE_URL=postgresql+asyncpg://agent_office_admin:replace-with-generated-admin-password@db:5432/agent_office_test
RUNNER_UID=1000
RUNNER_GID=1000
NINEROUTER_KEY=your-provider-key
SESSION_TTL_SECONDS=28800
# Must be true whenever PUBLIC_ORIGIN uses https. Loopback HTTP dev may use false.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
LOG_LEVEL=INFO
